RELEARN_ENVIRONMENT=development
RELEARN_DATABASE_URL=postgresql+psycopg://relearn:relearn@localhost:5432/relearn
RELEARN_CORS_ORIGINS=["http://localhost:3000"]
RELEARN_DIAGNOSIS_PROVIDER=rule-based

# Optional: powers the learner-friendly code-review wording. Keep this key on
# the FastAPI server; never expose it through NEXT_PUBLIC_* or commit .env.
RELEARN_GEMINI_API_KEY=
RELEARN_GEMINI_MODEL=gemini-2.5-flash
RELEARN_GEMINI_TIMEOUT_SECONDS=12
